# =============================================================================
# LOCAL OPENAI-COMPATIBLE API (alternative provider)
# =============================================================================
# For local OpenAI-compatible servers (llama.cpp, vLLM, text-generation-webui,
# LocalAI, Oobabooga, ...). Every supported local server exposes the
# OpenAI-compatible /v1 API, so a single provider covers all cases.
LOCAL_OPENAI_BASE_URL=http://localhost:8080/v1
# Most local servers don't require a key; empty/missing falls back to 'not-needed'.
LOCAL_OPENAI_API_KEY=not-needed

# =============================================================================
# COGNEE — RELATIONAL + VECTOR DATABASE (postgres + pgvector)
# =============================================================================
# cognee stores its metadata/graph in Postgres and vectors in pgvector.
# The docker-compose.yml `postgres` service (pgvector/pgvector:pg18-trixie)
# provides these defaults. For a local (non-Docker) run, set DB_HOST=localhost
# and run a local Postgres+pgvector, OR rely on init_cognee()'s non-fatal
# fallback (cognee falls back to SQLite/LanceDB when Postgres is unreachable).
#
# DOCKER NOTE: DB_* / VECTOR_DB_* / GRAPH_DATABASE_* credentials + the pool
# args below are ALREADY pinned in docker-compose.yml (host=postgres, the
# in-network service). Under `docker compose up` these compose values win and
# you do NOT need to set them here -- a .env is optional. The lines below are
# for LOCAL (non-Docker) runs only.
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognee_db
DB_USERNAME=cognee
DB_PASSWORD=cognee
VECTOR_DB_PROVIDER=pgvector

# --- Graph database credentials (Postgres graph store) ---
# cognee's GraphEngine stores the graph in Postgres. When these are not set,
# cognee falls back to the DB_* values above but logs a noisy WARNING:
#   "Postgres graph credentials are not fully configured; falling back to the
#    relational database configuration. Set GRAPH_DATABASE_HOST/PORT/..."
# api/cognee/_runtime.py sets sensible defaults mirroring DB_*, so the warning
# is silenced. Set them here ONLY for a local run, or override the docker-
# compose hardcoded values by editing docker-compose.yml (compose `environment:`
# wins over .env, so a .env line cannot override a hardcoded compose value).
# GRAPH_DATABASE_HOST=localhost
# GRAPH_DATABASE_PORT=5432
# GRAPH_DATABASE_NAME=cognee_db
# GRAPH_DATABASE_USERNAME=cognee
# GRAPH_DATABASE_PASSWORD=cognee

# --- Vector database credentials (pgvector store) ---
# cognee's VectorEngine stores embeddings in pgvector. When these are not set,
# cognee falls back to the DB_* values above but logs a noisy WARNING:
#   "PGVector credentials are not fully configured; falling back to the
#    relational database configuration. Set VECTOR_DB_HOST/PORT/..."
# api/cognee/_runtime.py sets sensible defaults mirroring DB_*, so the warning
# is silenced and the vector store uses the SAME Postgres as the relational +
# graph stores. Same DOCKER NOTE applies: already pinned in docker-compose.yml.
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=5432
# VECTOR_DB_NAME=cognee_db
# VECTOR_DB_USERNAME=cognee
# VECTOR_DB_PASSWORD=cognee

# --- Connection pool args (asyncpg cross-loop crash fix) ---
# cognee's default AsyncAdaptedQueuePool RETAINS pooled asyncpg connections
# across event loops. In FastAPI this surfaces as a hard crash:
#   RuntimeError: Task ... got Future ... attached to a different loop
# Setting poolclass to "nullpool" makes cognee use SQLAlchemy's NullPool,
# which opens a fresh connection (on the current loop) per checkout and never
# retains one across loops. cognee/_runtime.py monkeypatches create_async_engine
# to convert "nullpool" string into NullPool class across all adapters.
# ALREADY pinned in docker-compose.yml (single-quoted JSON literal). Override
# there for Docker; set here only for local non-Docker runs.
# Default applied by api/cognee/_runtime.py (overridable):
#   {"poolclass": "nullpool", "pool_pre_ping": true}
# DATABASE_POOL_ARGS={"poolclass":"nullpool","pool_pre_ping":true}
# POOL_ARGS={"poolclass":"nullpool","pool_pre_ping":true}

# =============================================================================
# COGNEE — LLM (local OpenAI-compatible server, NO cloud key)
# =============================================================================
#
# LLM_ENDPOINT MUST use the OpenAI-compatible path ("/v1").
# LLM_API_KEY is a non-empty placeholder — local servers ignore the value, but
# cognee requires it to be non-empty (set it to any string, e.g. "not-needed").
LLM_PROVIDER=openai
LLM_ENDPOINT=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=not-needed
# Skip cognee's blocking LLM connection test (item 10 bug fix). Default true so
# cognify() starts immediately instead of timing out for ~30s against a slow
# local model. Set to false to re-enable the test.
COGNEE_SKIP_CONNECTION_TEST=true
# --- Centralized timeouts (admin panel → Timeouts) ---
# Every timeout is resolved with precedence: admin store (timeouts.<key>) >
# ENV VAR > default. Set them in the admin panel for runtime control without a
# restart; the ENV VARs below are the fallback when the admin store is unset.
# Defaults are raised so multi-hour indexing on large repos is not aborted.
# All values in SECONDS unless noted. Floors protect against dangerous typos.
#
# LLM_REQUEST_TIMEOUT_SECONDS       default 3600  floor 60
# Per-request HTTP timeout for every OpenAI-compatible client (adalflow
# OpenAIClient, the patched openai.AsyncOpenAI/openai.OpenAI used by cognee /
# litellm / instructor).
# LLM_REQUEST_TIMEOUT_SECONDS=3600
#
# LLM_RETRY_MAX_TIME_SECONDS        default 900   floor 30
# Total retry budget for the backoff decorator on transient errors
# (APITimeoutError / RateLimitError / 5xx) on the adalflow OpenAIClient
# call()/acall().
# LLM_RETRY_MAX_TIME_SECONDS=900
#
# MODEL_LIST_TIMEOUT_SECONDS        default 10    floor 1
# HTTP timeout for model listing / existence checks (config.py fetchers,
# model_utils).
# MODEL_LIST_TIMEOUT_SECONDS=10
#
# PROVIDER_TEST_TIMEOUT_SECONDS     default 15    floor 3
# HTTP timeout for the admin panel provider connection test.
# PROVIDER_TEST_TIMEOUT_SECONDS=15
#
# COGNEE_GRAPH_EXTRACTION_TIMEOUT   default 1800  floor 60
# Per-chunk timeout for cognee graph extraction (structured-output LLM call
# inside cognify). The patched wrapper returns an empty model on timeout so
# cognify keeps making progress. The default is 1800s (30 min) so a slow
# corporate gateway doing markdown_json_mode extraction (full section's worth
# of tokens before the JSON parse) is not aborted per chunk.
# COGNEE_GRAPH_EXTRACTION_TIMEOUT=1800
#
# COGNEE_COGNIFY_TIMEOUT            default 7200  floor 300
# Overall timeout for a full cognee.cognify() run over a dataset. A timeout is
# treated as a SOFT success (cognee commits graph nodes + vectors per chunk).
# Large repos can index for hours.
# COGNEE_COGNIFY_TIMEOUT=7200
#
# COGNEE_LLM_CONNECTION_TIMEOUT     default 10    floor 1
# Best-effort timeout (seconds) for the cognee LLM connection test, if cognee
# honors it.
# COGNEE_LLM_CONNECTION_TIMEOUT=10
#
# DOCGEN_INDEXING_DRAIN_SECONDS     default = cognify  floor 5
# Best-effort drain ceiling for the docgen worker thread's leftover background
# tasks. Defaults to the resolved COGNEE_COGNIFY_TIMEOUT so a leftover cognify
# task gets the full budget instead of being killed at 30s (which previously
# dropped the connection mid-graph-build). NON-FATAL.
# DOCGEN_INDEXING_DRAIN_SECONDS=7200
#
# MEMORY_QUERY_TIMEOUT_SECONDS       default 30    floor 5
# Timeout for the pgvector memory backend's cosine-recall query (embed query +
# ORDER BY embedding <=> :q LIMIT k). On timeout the backend returns "" and the
# expert agent falls back to artifact docs. The HNSW index keeps the query fast.
# MEMORY_QUERY_TIMEOUT_SECONDS=30
#
# RLM_API_TIMEOUT_MS                default 3600000  floor 30000  (MILLISECONDS)
# Per-API-call timeout for fast-rlm. fast-rlm's Pyodide REPL reads this from
# the process env and cannot reach host Python, so admin saves are exported to
# this env var by sync_timeout_env().
# RLM_API_TIMEOUT_MS=3600000
#
# RLM_SECTION_TIMEOUT               default 1800  floor 60
# Per-section RLM timeout for the docgen path (api/docgen/codebase.py).
# RLM_SECTION_TIMEOUT=1800
#
# RLM_EXPERT_TIMEOUT                default 1800  floor 60
# Per-section RLM timeout for the expert-agent path (expert_agent).
# RLM_EXPERT_TIMEOUT=1800
#
# INTEGRATION_HTTP_TIMEOUT_SECONDS  default 30    floor 5
# HTTP timeout for integration connectors (github / gitlab / confluence / mcp).
# INTEGRATION_HTTP_TIMEOUT_SECONDS=30
#
# GIT_FILE_CONTENT_TIMEOUT_SECONDS   default 30    floor 5
# HTTP timeout for GitHub/GitLab file-content API fetches (data_pipeline).
# GIT_FILE_CONTENT_TIMEOUT_SECONDS=30
#
# MCP_STDIO_WAIT_SECONDS            default 10    floor 1
# Timeout for .wait() on the MCP stdio subprocess.
# MCP_STDIO_WAIT_SECONDS=10
#
# MERMAID_VERIFY_TIMEOUT            default 15    floor 3
# Per-diagram Node verification timeout (mermaid_verifier).
# MERMAID_VERIFY_TIMEOUT=15
#
# MERMAID_REPAIR_TIMEOUT            default 180   floor 10
# Per-LLM-repair-call timeout for mermaid (mermaid_verifier).
# MERMAID_REPAIR_TIMEOUT=180
#
# MERMAID_MAX_REPAIR_ATTEMPTS        default 3     floor 1
# Max LLM repair attempts per UNIQUE mermaid diagram body (keyed by hash).
# MERMAID_MAX_REPAIR_ATTEMPTS=3

# =============================================================================
# COGNEE — EMBEDDINGS (local OpenAI-compatible server; optional overrides)
# =============================================================================
# Derived automatically from LOCAL_OPENAI_BASE_URL by api/cognee/_runtime.py.
# Override only if you use a different embedding setup.
#
# EMBEDDING_ENDPOINT uses the OpenAI-compatible path ("/v1").
# EMBEDDING_DIMENSIONS must match nomic-embed-text (768).
# HUGGINGFACE_TOKENIZER is REQUIRED by cognee for token counting with the
# embedding model; it must be set together with the other EMBEDDING_* vars.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_ENDPOINT=http://localhost:1234/v1
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=not-needed
HUGGINGFACE_TOKENIZER=nomic-ai/nomic-embed-text-v1.5

# =============================================================================
# COGNEE — SINGLE-USER MODE (disable multi-tenant access control)
# =============================================================================
# cognee 1.2.x defaults to ENABLE_BACKEND_ACCESS_CONTROL=true (per-user/per-tenant
# dataset isolation + mandatory auth). Productarium runs as one local instance
# with its OWN auth layer and treats cognee's graph as a single shared knowledge
# base (one dataset per product), so multi-tenant isolation is neither needed nor
# desirable. With EBAC on, add()/cognify()/recall() resolve a tenant-less default
# user and crash inside dataset/vector routing with
# "cannot read properties of undefined tenantID". We therefore force single-user
# mode (shared DB, no auth, no tenant routing) here.
# Set to true ONLY if you genuinely want multi-tenant cognee (you will also need
# VECTOR_DATASET_DATABASE_HANDLER and proper user/tenant setup).
ENABLE_BACKEND_ACCESS_CONTROL=false

# =============================================================================
# FAST-RLM (iterative reasoning, optional)
# =============================================================================
# fast-rlm talks to an OpenAI-compatible endpoint. By default it points at local
# LM Studio (http://localhost:1234/v1) when LOCAL_OPENAI_BASE_URL is not set.
# RLM_MODEL_API_KEY is a non-empty placeholder; falls back to 'not-needed'.
RLM_MODEL_BASE_URL=http://localhost:1234/v1
RLM_MODEL_API_KEY=not-needed
# Model id used by fast-rlm (an OpenAI-compatible server model id).
RLM_MODEL_NAME=qwen/qwen3.6-27b

# --- RLM model context window (context-size-exceeded fix) ---
# fast-rlm's default max_prompt_tokens is 200k. On a local model with a smaller
# num_ctx (e.g. qwen3.6-27b default ~8k-32k), this overflows the context window
# and fast-rlm fails with:
#   litellm.BadRequestError: ... Context size has been exceeded
# Set RLM_MODEL_CONTEXT_WINDOW to the model's actual context window (in tokens)
# and api/rlm/runner.py + api/docgen/codebase.py will:
#   - clamp the chunk budget passed to RLM so each chunk fits the window
#   - cap max_prompt_tokens to (context_window - completion_budget)
#   - cap max_completion_tokens to max(1024, context_window//4)
# Example for a model with a 32k context:
# RLM_MODEL_CONTEXT_WINDOW=32768

# =============================================================================
# SSL / TLS (corporate AI gateway with an internal CA)
# =============================================================================
# Configure these when an HTTPS LLM/embedder endpoint (e.g. a corporate AI
# gateway) uses a certificate signed by an internal/enterprise CA that is NOT
# in Python's default trust store. Without this you get
# "unable to get local issuer certificate" / SSL: CERTIFICATE_VERIFY_FAILED.
#
# Two knobs (also configurable at runtime from the admin panel → SSL / TLS):
#
# 1) CA bundle path (RECOMMENDED — keeps verification ON).
#    Point every HTTP client (requests, httpx, OpenAI SDK, cognee aiohttp) at
#    your corporate root cert. Set this to a .pem/.crt on disk.
#    On macOS, if the corporate cert is only in the Keychain, export it first:
#      Keychain Access → System → find the root CA → right-click → Export (.pem)
#      (or: security find-certificate -a -p /Library/Keychains/System.keychain \
#            /path/to/corporate-root.pem)
# SSL_CA_BUNDLE=/absolute/path/to/corporate-root.pem
# (SSL_CERT_FILE / REQUESTS_CA_BUNDLE / CURL_CA_BUNDLE are honored too and are
#  set automatically from SSL_CA_BUNDLE / the admin panel when configured.)
#
# 2) Skip certificate verification (INSECURE — MITM risk).
#    Only use as a fallback when you have NO CA file (e.g. the corporate cert
#    lives only in the OS keychain and you cannot export it). Disables TLS
#    verification for ALL outbound LLM/embedder/cognee calls. Local HTTP model
#    servers are unaffected.
# SSL_VERIFY=false

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# API server port (default: 8001)
PORT=8001
# Configuration directory (optional, for custom config location)
# DEEPWIKI_CONFIG_DIR=/path/to/custom/config

# =============================================================================
# ENTERPRISE GIT (Optional)
# =============================================================================
# Default URLs for enterprise/self-hosted Git instances (overridable per request).
# GITHUB_ENTERPRISE_URL=https://github.mycompany.com
# GITLAB_SELF_HOSTED_URL=https://gitlab.mycompany.com

# =============================================================================
# AUTHENTICATION (Productarium — local + Keycloak)
# =============================================================================
# Auth provider: local (default) | keycloak | both | none
# - local:    username/password login (passlib bcrypt + JWT session cookie)
# - keycloak: OIDC redirect login via Keycloak (configure KEYCLOAK_* below)
# - both:     local + keycloak endpoints both enabled
# - none:     auth disabled; get_current_user returns a bootstrap/system admin
AUTH_PROVIDER=local
# One-shot bootstrap admin (created on startup if no admin exists; non-fatal).
# Leave unset to skip. Change the password after first login.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# Secret used to encrypt settings_store secrets (Fernet) and to sign session
# JWTs. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, an ephemeral dev key is generated (WARNING logged; not for production).
# SETTINGS_SECRET_KEY=<paste a 32-byte url-safe base64 key>

# --- Keycloak OIDC (only when AUTH_PROVIDER=keycloak|both) ---
# Defaults below assume a local Keycloak on port 8080 with a public client
# (empty secret). Adjust for your deployment.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=productarium-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REALM=productarium

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO
# Log format: logfmt (default) or json. Output is console-only.
# LOG_FORMAT=logfmt
# Max characters per formatted log record (default: 8192). Long records
# (e.g. adalflow's `log.info(f"output: {output}")` dumping multi-KB model
# output) are truncated to this length. This, together with the non-blocking
# QueueHandler/QueueListener in api/utils/logging.py, prevents
#   BlockingIOError: [Errno 11] write could not complete without blocking
# which occurs when worker threads write to a full stdout pipe.
# LOG_MAX_RECORD_CHARS=8192
