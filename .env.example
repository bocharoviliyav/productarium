# =============================================================================
# LOCAL OPENAI-COMPATIBLE API
# =============================================================================
# For local OpenAI-compatible servers (LM Studio, llama.cpp, vLLM, LocalAI, ...).
# Every supported local server exposes the OpenAI-compatible /v1 API, so a
# single provider covers all cases. No cloud keys required.
LOCAL_OPENAI_BASE_URL=http://localhost:8080/v1
# Most local servers don't require a key; empty/missing falls back to 'not-needed'.
LOCAL_OPENAI_API_KEY=not-needed
# Default generation model id (used when the admin panel has no model set).
# LOCAL_OPENAI_MODEL=qwen/qwen3.6-27b
# Legacy aliases honored as fallbacks (api/config/settings.py) when the
# LOCAL_OPENAI_* variables are unset:
# LLM_MODEL=qwen/qwen3.6-27b
# LLM_API_KEY=not-needed

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
# One Postgres instance stores products/artifacts, chat sessions, agent
# checkpoints and the pgvector knowledge chunks (cosine recall + HNSW index).
# The docker-compose.yml `postgres` service (pgvector/pgvector:pg18-trixie)
# provides these defaults. For a local (non-Docker) run, set DB_HOST=localhost
# and run a local Postgres+pgvector, OR use the SQLite degraded mode below.
# DOCKER NOTE: DB_* credentials are pinned in docker-compose.yml (host=postgres);
# compose values win over .env. The lines below are for LOCAL runs only.
DB_PROVIDER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cognee_db
DB_USERNAME=cognee
DB_PASSWORD=cognee

# --- SQLite degraded mode (local run without a Postgres server) ---
# Set DB_PROVIDER=sqlite to store everything (products, chat sessions, agent
# checkpoints, knowledge chunks without vectors) in a single SQLite file. The
# file path resolves from DB_NAME: an explicit path, a bare name with DB_HOST
# pointing at a directory, or a bare name under PRODUCTARIUM_STATE_DIR.
# Semantic (cosine) recall is unavailable in this mode; the expert agent falls
# back to artifact-docs + recent-chunks recall.
# DB_PROVIDER=sqlite
# DB_NAME=/tmp/productarium/productarium.db

# --- Managed state directory ---
# Root for everything the app writes outside the DB: SQLite files (bare-name
# mode), repository clones, the LangGraph agent checkpointer (SQLite backend).
# Default: ~/.productarium
# PRODUCTARIUM_STATE_DIR=/var/lib/productarium
# Test-only override: force the in-memory LangGraph checkpointer instead of
# Postgres/SQLite (api/agents/runtime.py). Leave unset in production.
# PRODUCTARIUM_CHECKPOINTER=memory

# --- Local-filesystem clone safety switch ---
# repo_url values that are LOCAL paths (not github/gitlab https URLs) are
# rejected by default: an LLM-driven pipeline should not be pointed at
# arbitrary directories on the host. Set to an explicit truthy value only for
# trusted local development.
# PRODUCTARIUM_ALLOW_LOCAL_CLONES=false

# =============================================================================
# CENTRALIZED TIMEOUTS (admin panel → Timeouts)
# =============================================================================
# Every timeout is resolved with precedence: admin store (timeouts.<key>) >
# ENV VAR > default. Set them in the admin panel for runtime control without a
# restart; the ENV VARs below are the fallback when the admin store is unset.
# All values in SECONDS. Floors protect against dangerous typos.
# (Registry: api/config/timeout.py — the admin UI renders one field per key.)
#
# LLM_REQUEST_TIMEOUT_SECONDS       default 3600  floor 60
# Per-request HTTP timeout for every OpenAI-compatible client (langchain
# ChatOpenAI / OpenAIEmbeddings + the patched openai SDK).
# LLM_REQUEST_TIMEOUT_SECONDS=3600
#
# LLM_RETRY_MAX_TIME_SECONDS        default 900   floor 30
# Total retry budget for transient errors (timeouts / 429 / 5xx).
# LLM_RETRY_MAX_TIME_SECONDS=900
#
# MODEL_LIST_TIMEOUT_SECONDS        default 10    floor 1
# HTTP timeout for model listing / existence checks.
# MODEL_LIST_TIMEOUT_SECONDS=10
#
# PROVIDER_TEST_TIMEOUT_SECONDS     default 15    floor 3
# HTTP timeout for the admin panel provider connection test.
# PROVIDER_TEST_TIMEOUT_SECONDS=15
#
# DOCGEN_INDEXING_DRAIN_SECONDS     default 300   floor 5
# Best-effort drain ceiling for the docgen worker thread's leftover background
# indexing tasks. NON-FATAL: the docs are already committed at that point.
# DOCGEN_INDEXING_DRAIN_SECONDS=300
#
# MEMORY_QUERY_TIMEOUT_SECONDS      default 30    floor 5
# Timeout for the pgvector memory backend's cosine-recall query (embed query +
# ORDER BY embedding <=> :q LIMIT k). On timeout the backend returns "" and the
# expert agent falls back to artifact docs.
# MEMORY_QUERY_TIMEOUT_SECONDS=30
#
# INTEGRATION_HTTP_TIMEOUT_SECONDS  default 30    floor 5
# HTTP timeout for integration connectors (github / gitlab / confluence).
# INTEGRATION_HTTP_TIMEOUT_SECONDS=30
#
# GIT_FILE_CONTENT_TIMEOUT_SECONDS  default 30    floor 5
# HTTP timeout for GitHub/GitLab file-content API fetches.
# GIT_FILE_CONTENT_TIMEOUT_SECONDS=30
#
# MCP_STDIO_WAIT_SECONDS            default 10    floor 1
# Timeout for .wait() on an MCP stdio subprocess.
# MCP_STDIO_WAIT_SECONDS=10
#
# MERMAID_VERIFY_TIMEOUT            default 15    floor 3
# Per-diagram Node verification timeout (mermaid_verifier).
# MERMAID_VERIFY_TIMEOUT=15
#
# MERMAID_REPAIR_TIMEOUT            default 180   floor 10
# Per-LLM-repair-call timeout for mermaid diagrams.
# MERMAID_REPAIR_TIMEOUT=180
#
# MERMAID_MAX_REPAIR_ATTEMPTS       default 3     floor 1
# Max LLM repair attempts per UNIQUE mermaid diagram body (keyed by hash).
# MERMAID_MAX_REPAIR_ATTEMPTS=3
#
# MERMAID_REPAIR_DEADLINE_SECONDS    default 600   floor 10
# Wall-clock budget for the WHOLE mermaid repair drain of one page (P1-15), so
# a mutating LLM producing a fresh broken diagram on every call cannot spin
# the loop indefinitely.
# MERMAID_REPAIR_DEADLINE_SECONDS=600
#
# DOCGEN_MAP_CONCURRENCY             default 3     floor 1   (PARALLEL CALLS)
# Max parallel LLM calls in the agentic docgen MAP phase (P1-24). 1 = the old
# strictly sequential behavior; raise for faster large-repo docgen when the
# local model server can take the load. The RLM map loop stays sequential.
# DOCGEN_MAP_CONCURRENCY=3
#
# ENTITY_LOCK_TIMEOUT_SECONDS         default 5     floor 0.1
# How long an API entity write waits for the per-entity docgen lock before
# answering 409 Conflict (the running docgen job holds the lock for its
# whole run).
# ENTITY_LOCK_TIMEOUT_SECONDS=5
#
# SETTINGS_CACHE_TTL_SECONDS          default 5
# TTL of the admin settings-store read cache (0 disables caching).
# SETTINGS_CACHE_TTL_SECONDS=5
#
# LLM_PRECISE_TOKENS                  default 0     (0/1)
# Count tokens via the model server's tokenizer endpoint instead of the
# chars/4 heuristic (needs a server that exposes /tokenize).
# LLM_PRECISE_TOKENS=0
#
# UPLOAD_MAX_BYTES                    default 52428800   (50 MiB)
# Max accepted knowledge-node upload size.
# UPLOAD_MAX_BYTES=52428800
#
# KEYCLOAK_ROLE_MAPPING               default (unset)
# JSON object mapping Keycloak realm/client roles to productarium roles
# (overrides the mapping configured in the admin panel; same shape).
# KEYCLOAK_ROLE_MAPPING=

# =============================================================================
# DOCGEN (documentation generation)
# =============================================================================
# Max concurrent docgen jobs (worker threads). Default 2.
# DOCGEN_MAX_WORKERS=2
# LLM judge stage of the docgen verification pipeline (citation checks,
# hallucination scoring, diff summary). Enabled by default; set false to skip.
# DOCGEN_JUDGE_ENABLED=true
# Opener-duplicate guard (api/docgen/prose_dedup.py): after all wiki sections
# are generated, their opening sentences are compared pairwise (Jaccard over
# Russian word stems, threshold 0.30 — calibrated in the fork, tunable). A
# conflict gets ONE LLM repair attempt; if it fails, the text stays and the
# defect is reported in page provenance ("opener-duplicate"). Enabled by
# default; set false to disable the guard entirely.
# DOCGEN_OPENER_DEDUP=true
# Env-only master switch for Mermaid diagram verification (Node-based syntax
# check). Set false to skip verification entirely (diagrams render unverified).
# MERMAID_VERIFY=true
# Legacy-named knob (kept for compatibility): the LLM context window in tokens
# used for token budgeting/clamping (api/utils/llm_tokens.py). Example for 32k:
# RLM_MODEL_CONTEXT_WINDOW=32768
# How many section agents run in parallel in the Python-orchestration fallback
# (api/docgen/codebase.py). Default 3.
# DOCGEN_SECTION_CONCURRENCY=3

# =============================================================================
# EXPERT AGENT
# =============================================================================
# Wall-clock budget for one Deep Research run (multi-iteration LangGraph flow).
# DEEP_RESEARCH_TIMEOUT_SECONDS=900
# Wall-clock budget for one expert-chat ask turn (api/expert/turns.py). The
# turn runs as a detached background task and survives client disconnects, so
# multi-minute answers are normal — keep this generous (default 1800 s,
# floor 60 s; also editable in the admin panel → Timeouts → Expert).
# EXPERT_STREAM_TIMEOUT_SECONDS=1800
# Lexical boost for expert recall (api/memory/lexical_boost.py): when the
# question carries code-like tokens (identifier, table name, file path), the
# knowledge chunks are also matched by exact text (ILIKE) and that ranking is
# fused with the pgvector cosine ranking — exact-name hits the embedder
# missed still surface, and recall survives an embedder outage. One layer,
# one flag for measurability; off = pure cosine (previous behavior). The
# textual stage is bounded by MEMORY_QUERY_TIMEOUT_SECONDS.
# EXPERT_LEXICAL_BOOST=true

# =============================================================================
# DATABASE REVERSE-ENGINEERING (MCP introspection flow)
# =============================================================================
# Overall budget for one database introspection + docgen job
# (api/docgen/database.py). Default 900 s.
# DB_INTROSPECTION_TIMEOUT_SECONDS=900
# Disk cache for MCP introspection results (api/docgen/introspection_cache.py):
# a rerun/repair after an interrupted database docgen job reuses the previously
# collected schema instead of re-walking a multi-hundred-MB MCP surface.
# Entries live under PRODUCTARIUM_STATE_DIR/introspection_cache (one JSON per
# MCP surface, written atomically). TTL in seconds; 0 disables the cache and
# makes every run introspect fresh. Default 7 days.
# DB_INTROSPECTION_CACHE_TTL_SECONDS=604800
# Wall-clock budget for the preset database connection check (api/mcp/presets.py):
# a REAL MCP handshake — launcher spawn + initialize + tools/list + one probe
# tool call. Generous default because the docker-fallback launcher may pull
# the server image on the very first check. Default 180 s, floor 5 s; also
# editable in the admin panel → Timeouts → Databases.
# DB_CONNECT_CHECK_SECONDS=180
# Force "API runs inside a container" detection (api/mcp/presets.py) for
# runtimes without /.dockerenv (containerd/k8s): a user-typed localhost DSN is
# rewritten to host.docker.internal for the baked preset launchers. Docker is
# detected automatically; set 1 only if auto-detection fails.
# PRODUCTARIUM_IN_CONTAINER=1
#
# --- DB RE docgen budgets (admin panel → Timeouts → Databases) ---
# NOT seconds — COUNTS, resolved with the same precedence (admin store > env >
# default) and re-read on every generation, so an admin change applies to the
# next run without a restart.
# Tables per strict-JSON LLM description batch (batched enrichment: a
# 61-table database costs 2 LLM calls, not 61; subpage structure itself stays
# deterministic). Default 40, floor 5.
# DB_DOCGEN_ENRICH_BATCH=40
# Max entity subpages (tables/views/triggers/…) rendered per database; the
# surplus stays on the category root page as folded rows — hidden, never
# dropped. Default 200, floor 1.
# DB_DOCGEN_MAX_SUBPAGES=200
# Max objects that get an LLM description per run (protects Oracle monoliths
# with thousands of objects; deterministic structure/DDL docs are unaffected).
# Default 250, floor 1.
# DB_DOCGEN_MAX_DESCRIPTIONS=250
# Max tables probed for constraints/indexes/relations during the walk —
# structure-rich tables first. Walk-affecting: participates in the
# introspection disk-cache key. Default 300, floor 1.
# DB_FK_EVIDENCE_TABLES=300
# Max non-table objects (views/triggers/routines/…) with fetched source or
# definition during the walk (also part of the cache key). Default 100, floor 1.
# DB_SOURCE_OBJECTS=100
# Cross-context toggle: inject a compact digest of the product's documented
# databases (schemas, top tables by FK degree) into codebase docgen briefs —
# supplementary context, explicitly marked NOT to be cited as repo paths.
# Default true.
# DOCGEN_DB_CONTEXT_ENABLED=true

# =============================================================================
# MCP PLATFORM (outbound tool manager + inbound server)
# =============================================================================
# Bounded time for ONE outbound MCP connect + tools/list (api/mcp/manager.py);
# also the HTTP transport timeout. A dead MCP server can never hang a request.
# Read directly from the env (not part of the admin timeouts registry).
# MCP_DISCOVERY_TIMEOUT_SECONDS=10
# Bound for the inbound MCP ask_expert tool (waits for the expert agent run).
# MCP_ASK_TIMEOUT_SECONDS=120
# Per-tool-call timeout for outbound MCP tool invocations. Default 60 s.
# MCP_TOOL_CALL_TIMEOUT_SECONDS=60
# Hard cap on a single MCP tool result forwarded into the agent context
# (characters). Default 100000.
# MCP_TOOL_RESULT_MAX_CHARS=100000
# Negative cache TTL: a FAILED discovery is remembered for this many seconds
# so known-dead servers are skipped without reconnect attempts. Default 30.
# MCP_NEGATIVE_CACHE_SECONDS=30

# =============================================================================
# EMBEDDER RATE LIMITS (shared /v1/embeddings client)
# =============================================================================
# Resolved with precedence: admin store (embedder.*) > ENV VAR > default.
# Defaults: max_concurrency=4, delay_seconds=0.1, rate_limit_rps=10
# (the effective delay is the larger of delay_seconds and 1/rate_limit_rps).
# EMBEDDER_MAX_CONCURRENCY=4
# EMBEDDER_DELAY_SECONDS=0.1
# EMBEDDER_RATE_LIMIT_RPS=10

# =============================================================================
# SSL / TLS (corporate AI gateway with an internal CA)
# =============================================================================
# Configure these when an HTTPS LLM/embedder endpoint (e.g. a corporate AI
# gateway) uses a certificate signed by an internal/enterprise CA that is NOT
# in Python's default trust store. Without this you get
# "unable to get local issuer certificate" / SSL: CERTIFICATE_VERIFY_FAILED.
#
# Two knobs (also configurable at runtime from the admin panel → SSL / TLS):
#
# 1) CA bundle path (RECOMMENDED — keeps verification ON).
#    Point every HTTP client (requests, httpx, OpenAI SDK) at your corporate
#    root cert. Set this to a .pem/.crt on disk. On macOS, if the corporate
#    cert is only in the Keychain, export it first:
#      Keychain Access → System → find the root CA → right-click → Export (.pem)
# SSL_CA_BUNDLE=/absolute/path/to/corporate-root.pem
# The standard CA-bundle variables are honored too as fallbacks and are set
# automatically from SSL_CA_BUNDLE / the admin panel when configured:
# SSL_CERT_FILE=/absolute/path/to/corporate-root.pem
# REQUESTS_CA_BUNDLE=/absolute/path/to/corporate-root.pem
# CURL_CA_BUNDLE=/absolute/path/to/corporate-root.pem
#
# 2) Skip certificate verification (INSECURE — MITM risk).
#    Only use as a fallback when you have NO CA file. Disables TLS
#    verification for ALL outbound LLM/embedder calls. Local HTTP model
#    servers are unaffected.
# SSL_VERIFY=false

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# API server port (default: 8001)
PORT=8001
# Backend base URL the Next.js server proxies /api/* requests to
# (next.config.ts rewrite target; backend FastAPI). Default: http://localhost:8001
# SERVER_BASE_URL=http://localhost:8001
# Timeout (ms) for the Next.js dev/standalone server's /api/* rewrite proxy
# (experimental.proxyTimeout). The default 30 s used to cut off long expert
# SSE streams mid-answer; 3 600 000 ms (1 h) matches EXPERT_STREAM_TIMEOUT_
# SECONDS on the backend. Frontend-only (read at server start).
# NEXT_PROXY_TIMEOUT_MS=3600000
# Configuration directory (optional, for custom config location)
# DEEPWIKI_CONFIG_DIR=/path/to/custom/config
# dev (default, hot-reload) | production
# NODE_ENV=development

# =============================================================================
# ENTERPRISE GIT (Optional)
# =============================================================================
# Default URLs for enterprise/self-hosted Git instances (overridable per
# request and from the admin panel → Git).
# GITHUB_ENTERPRISE_URL=https://github.mycompany.com
# GITLAB_SELF_HOSTED_URL=https://gitlab.mycompany.com

# =============================================================================
# CONFLUENCE (Optional; env fallbacks — the admin panel → Confluence is primary)
# =============================================================================
# CONFLUENCE_BASE_URL=https://confluence.mycompany.com
# CONFLUENCE_USERNAME=
# CONFLUENCE_TOKEN=
# CONFLUENCE_SPACE=

# =============================================================================
# HTTP SECURITY
# =============================================================================
# Comma-separated CORS origin allowlist (the frontend is same-origin via its
# /api proxy and needs no CORS; this only matters for direct browser-to-API
# calls). "*" enables the wildcard origin AND disables credentials (the
# wildcard+credentials combination is invalid per the CORS spec).
# Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# Add the Secure attribute to every session/OAuth cookie. Set to true when
# serving behind HTTPS. Default: false (plain-HTTP local runs).
# COOKIE_SECURE=false

# =============================================================================
# AUTHENTICATION (Productarium — local + Keycloak)
# =============================================================================
# Auth provider: local (default) | keycloak | both | none
# - local:    username/password login (passlib bcrypt + JWT session cookie)
# - keycloak: OIDC redirect login via Keycloak (configure KEYCLOAK_* below)
# - both:     local + keycloak endpoints both enabled
# - none:     auth disabled; get_current_user returns a bootstrap/system admin
AUTH_PROVIDER=local
# One-shot bootstrap admin (created on startup if no admin exists; non-fatal).
# Leave unset to skip. Change the password after first login.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=change-me
# Secret used to encrypt settings_store secrets (Fernet) and to sign session
# JWTs. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, an ephemeral dev key is generated (WARNING logged; not for production).
# SETTINGS_SECRET_KEY=<paste a 32-byte url-safe base64 key>
# Optional dedicated JWT signing secret (falls back to SETTINGS_SECRET_KEY).
# JWT_SECRET_KEY=
# Session token TTL in seconds (default 7 days).
# SESSION_TOKEN_TTL=604800

# --- Keycloak OIDC (only when AUTH_PROVIDER=keycloak|both) ---
# Defaults below assume a local Keycloak on port 8080 with a public client
# (empty secret). Adjust for your deployment.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_CLIENT_ID=productarium-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REALM=productarium

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO
# Log format: logfmt (default) or json. Output is console-only.
# LOG_FORMAT=logfmt
# Max characters per formatted log record (default: 8192). Long records are
# truncated; together with the non-blocking QueueHandler/QueueListener in
# api/utils/logging.py this prevents writes to a full stdout pipe from
# blocking worker threads.
# LOG_MAX_RECORD_CHARS=8192
